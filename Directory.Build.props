<Project>

  <!-- Compilation settings, shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Identity. Version is the single place to bump before packing. -->
  <PropertyGroup>
    <Authors>Nandika</Authors>
    <Company>Nandika</Company>
    <Product>ColumnStore.Data</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) Nandika</Copyright>
  </PropertyGroup>

  <!-- NuGet packaging defaults. Only the two src projects set IsPackable true; tests and benchmarks opt out. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageProjectUrl>https://github.com/NandikaDevarajan/DataTableLite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NandikaDevarajan/DataTableLite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Shared across both packages. The SQL Server package appends its own terms to these rather than replacing
         them, so a search for any of these finds both. -->
    <PackageTags>DataTable;ColumnStore;DataTableLite;Columnar;Memory;Performance;.NET</PackageTags>
  </PropertyGroup>

  <!-- Symbols and source stepping, so a consumer can debug into the package. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
